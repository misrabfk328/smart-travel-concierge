# Local development configuration
# Copy to .env and fill in your GCP project or Gemini API key.
# For production deployment, Secret Manager injects credentials securely.

# Gemini platform / Vertex AI configuration (default)
GOOGLE_GENAI_USE_ENTERPRISE=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global

# Alternatively, for Gemini API via Google AI Studio:
# GOOGLE_GENAI_USE_ENTERPRISE=false
# GEMINI_API_KEY=your-api-key-here

# Strategic Model Routing
FAST_MODEL=gemini-3.8-flash
PLANNING_MODEL=gemini-2.5-pro

# Security, Secret Manager & PII Redaction
USE_SECRET_MANAGER=false
ENABLE_CLOUD_DLP=false
MODEL_ARMOR_TEMPLATE_ID=

# Persistent SQLite session/memory storage (set true for ephemeral in-memory dev)
USE_IN_MEMORY_SESSION=false
TRAVEL_DATA_DIR=./data
LOG_LEVEL=INFO
